% Experiment 2(iii): Addition and Multiplication of Two Sequences 
clc; clear; close all; 
n = 0:2; 
x = [1 2 1]; 
y = [1 1 2]; 
zSum = x + y; 
zProd = x .* y; 
figure; 
subplot(2,2,1); stem(n,x,'filled'); grid on; 
title('x[n]'); xlabel('n'); ylabel('Amplitude'); 
subplot(2,2,2); stem(n,y,'filled'); grid on; 
title('y[n]'); xlabel('n'); ylabel('Amplitude'); 
subplot(2,2,3); stem(n,zSum,'filled'); grid on; 
title('Addition x[n]+y[n]'); xlabel('n'); ylabel('Amplitude'); 
subplot(2,2,4); stem(n,zProd,'filled'); grid on; 
title('Multiplication x[n]y[n]'); xlabel('n'); ylabel('Amplitude'); 